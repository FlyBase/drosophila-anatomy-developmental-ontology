AnnotationAssertion(rdfs:comment obo:FBbt_20010624 "Uncharacterized putative cell type from Marin et al. (2024), based on MANC v1.2.1 data (Takemura et al., 2024) from NeuPrint.")
AnnotationAssertion(rdfs:label obo:FBbt_20010624 "adult IN21A007 neuron")
