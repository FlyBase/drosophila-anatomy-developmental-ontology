AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0260535") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0262545") oboInOwl:hasRelatedSynonym obo:FBbt_20003492 "cL22c")
