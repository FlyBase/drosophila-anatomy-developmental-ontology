AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0262545") oboInOwl:hasRelatedSynonym obo:FBbt_20002627 "SLP233")
AnnotationAssertion(oboInOwl:id obo:FBbt_20002627 "FBbt:20002627")
AnnotationAssertion(rdfs:comment obo:FBbt_20002627 "Cell type identified in multiple EM datasets (Scheffer et al., 2020; Schlegel et al., 2024; Dorkenwald et al., 2024; Nern et al., 2025). Synapse locations are given where each cell of this type in neuprint has at least 10 connections. Other information from Nern et al. (2025) supplements.")
AnnotationAssertion(rdfs:label obo:FBbt_20002627 "adult lobula visual projection neuron LoVP64")
