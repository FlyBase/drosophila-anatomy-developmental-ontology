# Class: obo:FBbt_20003463 (adult descending neuron of the posterior brain DNpe035)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0259490") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0260535") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0260546") Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97766.1") obo:IAO_0000115 obo:FBbt_20003463 "Adult descending neuron of the posterior brain of the DNpe035 group (Berg et al., 2026). It belongs to the SMPpv1 hemilineage (Berg et al., 2026). It receives input in the ipsilateral superior lateral protocerebrum, superior medial protocerebrum and posterior lateral protocerebrum, the contralateral superior medial protocerebrum and flange, and the gnathal ganglion, prow, lower tectulum, intermediate tectulum and abdominal neuromere (Berg et al., 2026). It sends output to the ipsilateral superior lateral protocerebrum and superior medial protocerebrum, the contralateral superior medial protocerebrum and flange, and the gnathal ganglion, prow, lower tectulum, intermediate tectulum and abdominal neuromere (Berg et al., 2026). Its predicted neurotransmitter is acetylcholine (Eckstein et al., 2024; Berg et al., 2026).")
AnnotationAssertion(terms:contributor obo:FBbt_20003463 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20003463 "2020-07-30T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20003463 "fly_anatomy.ontology")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97766.1") oboInOwl:hasRelatedSynonym obo:FBbt_20003463 "DNxn138")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") oboInOwl:hasRelatedSynonym obo:FBbt_20003463 "SMP601")
AnnotationAssertion(oboInOwl:id obo:FBbt_20003463 "FBbt:20003463")
AnnotationAssertion(rdfs:comment obo:FBbt_20003463 "Cell type identified in multiple EM datasets (Scheffer et al., 2020; Schlegel et al., 2024; Dorkenwald et al., 2024; Marin et al., 2024; Berg et al., 2026). Synapse locations are given where each cell of this type in neuprint has at least 10 connections. Hemilineage information from neuprint, though original source not clear.")
AnnotationAssertion(rdfs:label obo:FBbt_20003463 "adult descending neuron of the posterior brain DNpe035")
