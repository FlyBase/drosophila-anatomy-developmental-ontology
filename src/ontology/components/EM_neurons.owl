AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20002626 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20002626 "FBbt:20002626")
AnnotationAssertion(rdfs:comment obo:FBbt_20002626 "Uncharacterized putative cell type (based on clustering analysis) from Janelia hemibrain data (Scheffer et al., 2020). Connectivity based on Hemibrain v1.2.1 data where each individual of this type has at least 10 synapses in a region.")
AnnotationAssertion(rdfs:label obo:FBbt_20002626 "adult superior lateral protocerebrum neuron 232")
