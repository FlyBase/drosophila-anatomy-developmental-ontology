AnnotationAssertion(terms:contributor obo:FBbt_20003713 <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20003713 "2020-07-30T12:00:00Z"^^xsd:dateTime)
