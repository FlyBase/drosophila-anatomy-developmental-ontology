AnnotationAssertion(terms:contributor obo:FBbt_20007592 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20007592 "2024-02-05T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20007592 "fly_anatomy.ontology")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0260535") Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0262545") oboInOwl:hasRelatedSynonym obo:FBbt_20007592 "LTe31")
AnnotationAssertion(oboInOwl:id obo:FBbt_20007592 "FBbt:20007592")
AnnotationAssertion(rdfs:comment obo:FBbt_20007592 "Cell type identified in multiple EM datasets (Schlegel et al., 2024; Dorkenwald et al., 2024; Nern et al., 2025). Synapse locations are given where each cell of this type in neuprint has at least 10 connections. Other information from Nern et al. (2025) supplements.")
AnnotationAssertion(rdfs:label obo:FBbt_20007592 "adult lobula visual projection neuron LoVP48")
