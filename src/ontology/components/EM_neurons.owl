AnnotationAssertion(terms:contributor obo:FBbt_20003733 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20003733 "2020-07-30T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") oboInOwl:hasExactSynonym obo:FBbt_20003733 "adult WED183 neuron")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20003733 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20003733 "FBbt:20003733")
AnnotationAssertion(rdfs:comment obo:FBbt_20003733 "Uncharacterized putative cell type (based on clustering analysis) from Janelia hemibrain data (Scheffer et al., 2020). Connectivity based on Hemibrain v1.2.1 data where each individual of this type has at least 10 synapses in a region.")
AnnotationAssertion(rdfs:label obo:FBbt_20003733 "adult wedge neuron 183")
