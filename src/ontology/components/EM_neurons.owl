# Class: obo:FBbt_20000000 (adult anterior optic tubercle neuron 001)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") obo:IAO_0000115 obo:FBbt_20000000 "Adult neuron belonging to group 001 of the terra incognita neurons with substantial synapsing in the anterior optic tubercle (Scheffer et al., 2020). It has postsynaptic sites in the lateral accessory lobe, anterior optic tubercle, lateral complex and ventrolateral neuropils (Scheffer et al., 2020). It has presynaptic sites in the lateral accessory lobe and lateral complex (Scheffer et al., 2020).")
AnnotationAssertion(terms:contributor obo:FBbt_20000000 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20000000 "2020-07-30T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") oboInOwl:hasExactSynonym obo:FBbt_20000000 "adult AOTU001 neuron")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20000000 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20000000 "FBbt:20000000")
AnnotationAssertion(rdfs:comment obo:FBbt_20000000 "Uncharacterized putative cell type (based on clustering analysis) from Janelia hemibrain data (Scheffer et al., 2020). Connectivity based on Hemibrain v1.2.1 data where each individual of this type has at least 10 synapses in a region.")
AnnotationAssertion(rdfs:label obo:FBbt_20000000 "adult anterior optic tubercle neuron 001")
