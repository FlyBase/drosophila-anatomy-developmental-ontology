# Class: obo:FBbt_20007683 (adult AN00A002 neuron)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0259490") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.96084.1") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97766.1") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97769.1") obo:IAO_0000115 obo:FBbt_20007683 "Adult ascending neuron of the AN00A002 group with bilateral VNC arbors (Takemura et al., 2024; Marin et al., 2024). It is a primary neuron of the 00A hemilineage (Takemura et al., 2024; Marin et al., 2024). It exits the VNC via the cervical connective (Takemura et al., 2024; Marin et al., 2024). Within the VNC it fasciculates with the curved ventrolateral tract (Takemura et al., 2024; Marin et al., 2024). It receives input in multiple regions and sends output to multiple regions (Takemura et al., 2024; Marin et al., 2024). Its predicted neurotransmitter is gaba (Eckstein et al., 2024). There is approximately one of these cells per organism with its soma in the prothoracic neuromere (Takemura et al., 2024; Marin et al., 2024).")
AnnotationAssertion(terms:contributor obo:FBbt_20007683 <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20007683 "2024-05-10T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20007683 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20007683 "FBbt:20007683")
AnnotationAssertion(rdfs:comment obo:FBbt_20007683 "Uncharacterized putative cell type from Marin et al. (2024), based on MANC v1.2.1 data (Takemura et al., 2024) from NeuPrint.")
AnnotationAssertion(rdfs:label obo:FBbt_20007683 "adult AN00A002 neuron")
