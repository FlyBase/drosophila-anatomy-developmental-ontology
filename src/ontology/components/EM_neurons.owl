AnnotationAssertion(Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97766.1") oboInOwl:hasRelatedSynonym obo:FBbt_20001821 "DNb07")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") oboInOwl:hasRelatedSynonym obo:FBbt_20001821 "PS066")
