AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") oboInOwl:hasRelatedSynonym obo:FBbt_20003151 "SMP289")
AnnotationAssertion(oboInOwl:id obo:FBbt_20003151 "FBbt:20003151")
AnnotationAssertion(rdfs:comment obo:FBbt_20003151 "Cell type identified in multiple EM datasets (Scheffer et al., 2020; Schlegel et al., 2024; Dorkenwald et al., 2024; Marin et al., 2024; Berg et al., 2026). Synapse locations are given where each cell of this type in neuprint has at least 10 connections. Hemilineage information from neuprint, though original source not clear.")
AnnotationAssertion(rdfs:label obo:FBbt_20003151 "adult descending neuron of the posterior brain DNpe033")
