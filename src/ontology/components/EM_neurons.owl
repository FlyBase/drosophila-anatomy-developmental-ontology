AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0246888") Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") oboInOwl:hasRelatedSynonym obo:FBbt_20001921 "PS166")
AnnotationAssertion(oboInOwl:id obo:FBbt_20001921 "FBbt:20001921")
AnnotationAssertion(rdfs:comment obo:FBbt_20001921 "Cell type identified in multiple EM datasets (Scheffer et al., 2020; Schlegel et al., 2024; Dorkenwald et al., 2024; Marin et al., 2024; Berg et al., 2026). Synapse locations are given where each cell of this type in neuprint has at least 10 connections.")
AnnotationAssertion(rdfs:label obo:FBbt_20001921 "adult descending neuron of the posterior brain DNpe027")
