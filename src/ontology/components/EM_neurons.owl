AnnotationAssertion(Annotation(oboInOwl:hasDbXref "doi:10.1016/j.cell.2026.08.015") Annotation(oboInOwl:hasDbXref "doi:10.7554/eLife.97766.1") oboInOwl:hasRelatedSynonym obo:FBbt_20001497 "DNit013")
