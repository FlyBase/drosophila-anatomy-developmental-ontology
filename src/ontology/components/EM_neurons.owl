AnnotationAssertion(terms:contributor obo:FBbt_20007740 <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20007740 "2024-05-10T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20007740 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20007740 "FBbt:20007740")
AnnotationAssertion(rdfs:comment obo:FBbt_20007740 "Uncharacterized putative cell type from Marin et al. (2024), based on MANC v1.2.1 data (Takemura et al., 2024) from NeuPrint.")
AnnotationAssertion(rdfs:label obo:FBbt_20007740 "adult AN05B044 neuron")
