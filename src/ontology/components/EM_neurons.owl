AnnotationAssertion(terms:contributor obo:FBbt_20002625 <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_20002625 "2020-07-30T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20002625 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20002625 "FBbt:20002625")
AnnotationAssertion(rdfs:comment obo:FBbt_20002625 "Uncharacterized putative cell type based on Hemibrain data (Scheffer et al., 2020) and updated using FlyWire (FAFB) data (Dorkenwald et al., 2024; Schlegel et al., 2024). Soma locations are based on the closest annotated neuropil region. Pre- or post-synapse locations are the fewest regions that collectively contain at least 80 percent of all pre- or post-synapses of these neurons in FlyWire. Neurotransmitter predictions are from Eckstein et al. (2024). Other annotations are based on annotations in FlyWire and are available in the supplemental material of Schlegel et al. (2024).")
AnnotationAssertion(rdfs:label obo:FBbt_20002625 "adult superior lateral protocerebrum neuron 231")
