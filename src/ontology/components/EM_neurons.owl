AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0260535") oboInOwl:hasExactSynonym obo:FBbt_20007288 "adult cLP01 neuron")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_20007288 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_20007288 "FBbt:20007288")
AnnotationAssertion(rdfs:comment obo:FBbt_20007288 "Uncharacterized putative cell type from Schlegel et al. (2024), based on FlyWire v783 (FAFB) data (Dorkenwald et al., 2024; Schlegel et al., 2024). Soma locations are based on the closest annotated neuropil region. Pre- or post-synapse locations are the fewest regions that collectively contain at least 80 percent of all pre- or post-synapses of these neurons in FlyWire. Neurotransmitter predictions are from Eckstein et al. (2024). Other annotations are based on annotations in FlyWire and are available in the supplemental material of Schlegel et al. (2024).")
AnnotationAssertion(rdfs:label obo:FBbt_20007288 "adult lobula plate visual centrifugal neuron 01")
