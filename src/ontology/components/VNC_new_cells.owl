# Class: obo:FBbt_00051089 (adult LBL40 neuron of ventral nerve cord)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0247391") Annotation(oboInOwl:hasDbXref "doi:10.1101/2023.05.31.542897") obo:IAO_0000115 obo:FBbt_00051089 "Bilateral neuron of the LBL40 group of the adult ventral nerve cord that primarily arborizes in the leg neuropil (Feng et al. 2020; Ehrhardt et al., 2023). It is an interneuron that arborizes mainly within one neuromere of the VNC (Feng et al. 2020; Ehrhardt et al., 2023). It has its soma in the metathoracic neuromere (Feng et al., 2020). It is strongly excited downstream of moonwalker descending neuron activity (Feng et al., 2020). There is 1 of these cells per hemineuromere (Feng et al., 2020).")
AnnotationAssertion(terms:contributor obo:FBbt_00051089 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_00051089 "2021-03-22T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0247391") oboInOwl:hasExactSynonym obo:FBbt_00051089 "adult MF01 neuron")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0247391") oboInOwl:hasNarrowSynonym obo:FBbt_00051089 "adult MT315 neuron")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_00051089 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_00051089 "FBbt:00051089")
AnnotationAssertion(rdfs:comment obo:FBbt_00051089 "Cell type described in Feng et al. (2020), nomenclature scheme explained in Ehrhardt et al. (2023).")
AnnotationAssertion(rdfs:label obo:FBbt_00051089 "adult LBL40 neuron of ventral nerve cord")
SubClassOf(obo:FBbt_00051089 obo:FBbt_00052046)
SubClassOf(obo:FBbt_00051089 ObjectSomeValuesFrom(obo:RO_0000053 obo:PATO_0000618))
SubClassOf(obo:FBbt_00051089 ObjectSomeValuesFrom(obo:RO_0002100 obo:FBbt_00111085))
SubClassOf(obo:FBbt_00051089 ObjectSomeValuesFrom(obo:RO_0013001 obo:FBbt_00047139))

# Class: obo:FBbt_00051090 (adult LUL24 neuron of ventral nerve cord)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0247391") Annotation(oboInOwl:hasDbXref "doi:10.1101/2023.05.31.542897") obo:IAO_0000115 obo:FBbt_00051090 "Unilateral neuron of the LUL24 group of the adult ventral nerve cord that primarily arborizes in the leg neuropil (Feng et al. 2020; Ehrhardt et al., 2023). It is an interneuron that arborizes mainly within one neuromere of the VNC (Feng et al. 2020; Ehrhardt et al., 2023). It has its soma in the prothoracic, mesothoracic or metathoracic neuromere (Feng et al., 2020). There is 1 of these cells per hemineuromere (Feng et al., 2020).")
AnnotationAssertion(terms:contributor obo:FBbt_00051090 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_00051090 "2021-03-22T12:00:00Z"^^xsd:dateTime)
