AnnotationAssertion(terms:contributor obo:FBbt_00053001 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_00053001 "2024-03-01T12:00:00Z"^^xsd:dateTime)
AnnotationAssertion(oboInOwl:hasOBONamespace obo:FBbt_00053001 "fly_anatomy.ontology")
AnnotationAssertion(oboInOwl:id obo:FBbt_00053001 "FBbt:00053001")
AnnotationAssertion(rdfs:label obo:FBbt_00053001 "adult WBL038 neuron of ventral nerve cord")
