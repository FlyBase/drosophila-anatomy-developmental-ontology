AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FlyBase:FBrf0247391") Annotation(oboInOwl:hasDbXref "doi:10.1101/2023.05.31.542897") obo:IAO_0000115 obo:FBbt_00051172 "Adult LUM9 neuron with its soma in the metathoracic neuromere (Feng et al., 2020). It is strongly excited downstream of moonwalker descending neuron activity (Feng et al., 2020). There are approximately 5 of these cells per hemineuromere (Feng et al., 2020).")
AnnotationAssertion(terms:contributor obo:FBbt_00051172 <http://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(terms:date obo:FBbt_00051172 "2021-03-22T12:00:00Z"^^xsd:dateTime)
