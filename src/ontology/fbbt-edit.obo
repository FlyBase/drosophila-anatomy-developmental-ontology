property_value: http://purl.org/dc/terms/date "2020-09-30T12:36:56Z" xsd:dateTime

[Term]
id: FBbt:00049828
name: adult gamma Kenyon cell
def: "Gamma Kenyon cell of the adult mushroom body. It develops from a larval gamma Kenyon cell that is remodeled during the pupal stage (Lee et al., 1999; Kunz et al., 2012). It expresses sNPF (Johard et al., 2008; Barnstedt et al., 2016; Croset et al., 2018). There are around 700 neurons of this type per hemisphere (Li et al., 2020)." [FlyBase:FBrf0111409, FlyBase:FBrf0202832, FlyBase:FBrf0218649, FlyBase:FBrf0231313, FlyBase:FBrf0238777, FlyBase:FBrf0248215]
synonym: "adult gamma KC" EXACT []
synonym: "adult gamma neuron" EXACT []
synonym: "adult mushroom body gamma neuron" EXACT []
