property_value: http://purl.org/dc/terms/date "2018-10-22T12:36:01Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/295" xsd:anyURI

