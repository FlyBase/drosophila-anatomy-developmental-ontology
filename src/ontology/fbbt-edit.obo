property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1147" xsd:anyURI

[Term]
id: FBbt:00058139
name: epithelial cell of dorsal peripodial epithelium of eye disc
def: "An epithelial cell of the dorsal peripodial epithelium of the eye disc. It is distinguished from its ventral counterpart by the expression of mirror (McNeill et al., 1997; Ariss et al., 2018)." [FlyBase:FBrf0093601, FlyBase:FBrf0240781]
subset: cur
intersection_of: FBbt:00000124 ! epithelial cell
intersection_of: BFO:0000050 FBbt:00058137 ! part of dorsal peripodial epithelium of eye disc
relationship: RO:0002292 http://flybase.org/reports/FBgn0014343 ! expresses mirr
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2021-05-25T12:14:05Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1147" xsd:anyURI

[Term]
id: FBbt:00058140
name: epithelial cell of ventral peripodial epithelium of eye disc
def: "An epithelial cell of the ventral peripodial epithelium of the eye disc. It is distinguished from its dorsal counterpart by the expression of ImpL2 (Ariss et al., 2018)." [FlyBase:FBrf0240781]
subset: cur
intersection_of: FBbt:00000124 ! epithelial cell
intersection_of: BFO:0000050 FBbt:00058138 ! part of ventral peripodial epithelium of eye disc
