property_value: http://purl.org/dc/terms/date "2022-01-18T13:48:13Z" xsd:dateTime

[Term]
id: FBbt:00052061
name: vagina
def: "Posterior part of the genital chamber (McQueen et al., 2022). It is an ectodermal invagination where insemination takes place (McQueen et al., 2022). It extends from the posterior edge of the uterine specialized intima anteriorly to the vulva posteriorly (McQueen et al., 2022)." [FlyBase:FBrf0040174, FlyBase:FBrf0200717, FlyBase:FBrf0253444]
synonym: "bursa" EXACT [FlyBase:FBrf0253444]
