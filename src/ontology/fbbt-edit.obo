property_value: http://purl.org/dc/terms/date "2024-05-14T13:26:12Z" xsd:dateTime

[Term]
id: FBbt:00053180
name: adult transverse horizontal neck muscle tendon cell
def: "Tendon cell at the anterior end of both of the transverse horizontal neck muscles (Gorko et al., 2024). It connects the muscle cells to the posterior head (Gorko et al., 2024)." [FlyBase:FBrf0259326]
synonym: "TH1/2 tendon" EXACT [FlyBase:FBrf0259326]
relationship: RO:0002177 FBbt:00003007 ! attached to part of adult head
