synonym: "Nod" EXACT [FlyBase:FBrf0212704]
synonym: "noduli" RELATED []
synonym: "ventral tubercle" EXACT [FlyBase:FBrf0049409, FlyBase:FBrf0240744]
is_a: FBbt:00040007 ! synaptic neuropil domain
