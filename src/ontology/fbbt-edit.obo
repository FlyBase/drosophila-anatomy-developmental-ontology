property_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0001-5948-3092
property_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-0027-0858
property_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-1373-1705
property_value: http://purl.org/dc/terms/creator https://orcid.org/0000-0002-6095-8718
