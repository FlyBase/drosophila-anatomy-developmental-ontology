property_value: http://purl.org/dc/terms/date "2020-02-25T12:38:32Z" xsd:dateTime

[Term]
id: FBbt:00047106
name: Notch ON hemilineage primary neuron
def: "Primary neuron belonging to a hemilineage that has active Notch signaling. In the larval ventral nerve cord, Notch ON neurons tend to project to the dorsal (motor) neuropil and have distinct morphologies from their Notch OFF counterparts in the same lineage (Mark et al., 2021)." [FlyBase:FBrf0249021]
synonym: "A hemilineage primary neuron" EXACT []
intersection_of: FBbt:00047097 ! primary neuron
