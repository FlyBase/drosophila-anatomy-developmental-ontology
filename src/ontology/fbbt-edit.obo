synonym: "larval ventral common exciter" EXACT [FlyBase:FBrf0253566]
synonym: "MNSNb/d-Is" EXACT [FlyBase:FBrf0132289]
synonym: "RP5 neuron" EXACT [FlyBase:FBrf0112030]
