property_value: http://purl.org/dc/terms/date "2020-05-12T14:45:52Z" xsd:dateTime

[Term]
id: FBbt:00049484
name: distal medullary amacrine neuron Dm-DRA2
def: "Distal medullary amacrine neuron that arborizes in layer M6, where it receives input from approximately 9 R8 photoreceptor cells of the dorsal rim area of the retina, but not photoreceptors outside of the dorsal rim area (Sancer et al., 2019; Kind et al., 2021). These cells do not project deeper than M6, but have vertical projections, extending upwards from M6, following incoming R8 terminals (Sancer et al., 2019). They vary in morphology based on their position (Sancer et al., 2019)." [FlyBase:FBrf0243430, FlyBase:FBrf0252485]
synonym: "DmDRA2" EXACT [FlyBase:FBrf0248724]
