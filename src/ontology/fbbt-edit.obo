[Term]
id: FBbt:00051393
name: adult sensory region of subesophageal zone
def: "Synaptic neuropil subdomain of the adult subesophageal zone that houses the axon terminals of sensory neurons (Miyazaki and Ito, 2010; Kendroud et al., 2018). Larger domains can be defined based on the projection patterns of neurons entering the brain via particular roots of the maxillary-labial, pharyngeal and antennal nerves (Kendroud et al., 2018). Many smaller domains, usually subdomains of the larger regions, can also be defined based on neuron morphology and function (Miyazaki and Ito, 2010; Munch et al., 2022)." [FlyBase:FBrf0211916, FlyBase:FBrf0237251, FlyBase:FBrf0254134]
synonym: "adult labellar gustatory association center" NARROW [FlyBase:FBrf0237251]
synonym: "adult labial gustatory center" NARROW [FlyBase:FBrf0237251]
synonym: "adult pharyngeal gustatory association center" NARROW []
synonym: "adult primary gustatory center" RELATED [FlyBase:FBrf0211916]
synonym: "adult SEZ sensory region" EXACT []
synonym: "PGC" RELATED [FlyBase:FBrf0211916]
synonym: "primary taste sensory neuropil" RELATED [FlyBase:FBrf0042883]
synonym: "taste-sensory region glomerulus" RELATED [FlyBase:FBrf0055600]
intersection_of: FBbt:00040006 ! synaptic neuropil subdomain
intersection_of: BFO:0000050 FBbt:00110639 ! part of adult subesophageal zone
intersection_of: RO:0002216 GO:0007600 ! capable of part of sensory perception
relationship: RO:0002131 FBbt:00007692 ! overlaps sensory system
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-1373-1705
property_value: http://purl.org/dc/terms/date "2021-07-02T12:39:01Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1201" xsd:anyURI

[Term]
id: FBbt:00051394
name: larval maxillary-labial nerve root
def: "Continuation of the larval maxillary-labial nerve into the neuropil (Kendroud et al., 2018). As the nerve approaches the neuropil, it splits into four main roots, which carry fibers to different parts of the larval gnathal ganglion (Kendroud et al., 2018)." [FlyBase:FBrf0237251]
synonym: "larval compound labial nerve root" EXACT [FlyBase:FBrf0237251]
synonym: "larval maxillary nerve root" NARROW [FlyBase:FBrf0240975]
intersection_of: FBbt:00007602 ! nerve root
intersection_of: RO:0002150 FBbt:00049187 ! continuous with larval maxillary-labial nerve
relationship: RO:0002134 FBbt:00100138 ! innervates larval gnathal ganglion
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-1373-1705
property_value: http://purl.org/dc/terms/date "2021-07-02T14:41:41Z" xsd:dateTime

[Term]
id: FBbt:00051395
name: larval maxillary-labial nerve posterior root
def: "Larval maxillary-labial nerve root that turns posteriorly and enters the neuropil of the labial neuromere (Kendroud et al., 2018)." [FlyBase:FBrf0237251]
synonym: "larval compound labial nerve posterior root" EXACT [FlyBase:FBrf0237251]
synonym: "larval lnp" EXACT [FlyBase:FBrf0237251]
synonym: "larval maxillary nerve B3" NARROW [FlyBase:FBrf0240975]
synonym: "larval maxillary nerve bundle 3" NARROW [FlyBase:FBrf0240975]
is_a: FBbt:00051394 ! larval maxillary-labial nerve root
relationship: RO:0002134 FBbt:00001974 ! innervates larval labial neuromere
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-1373-1705
property_value: http://purl.org/dc/terms/date "2021-07-02T14:50:11Z" xsd:dateTime

[Term]
id: FBbt:00051396
name: larval maxillary-labial nerve intermediate anterior root
def: "Larval maxillary-labial nerve root enters the neuropil at the level of the maxillary neuromere, in a similar position to the intermediate posterior root, then projects anteriorly to innervate the mandibular neuromere (Kendroud et al., 2018)." [FlyBase:FBrf0237251]
synonym: "intermediate root of the labial nerve anterior bundle" EXACT [FlyBase:FBrf0237251]
synonym: "larval compound labial nerve intermediate anterior root" EXACT [FlyBase:FBrf0237251]
synonym: "larval mna" EXACT [FlyBase:FBrf0237251]
is_a: FBbt:00051394 ! larval maxillary-labial nerve root
relationship: BFO:0000050 FBbt:00051409 ! part of larval maxillary-labial nerve intermediate root
relationship: RO:0002134 FBbt:00001973 ! innervates larval mandibular neuromere
