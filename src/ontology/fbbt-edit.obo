property_value: http://purl.org/dc/terms/date "2020-02-20T12:00:00Z" xsd:dateTime

[Term]
id: FBbt:00048876 ! NB3-5 lineage primary neuron
def: "Any neuron that develops from neuroblast NB3-5 during the embryonic phase of neurogenesis." [FlyBase:FBrf0231327]
