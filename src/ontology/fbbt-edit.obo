[Term]
id: FBbt:00059030
name: synchronous muscle
def: "Skeletal muscle that exhibits a direct relationship between motor neuron activity and muscle contraction. The fibrils of synchronous muscles are smaller than the ones from asynchronous ones. Most skeletal muscles are synchronous." [FlyBase:FBrf0239227]
subset: cur
is_a: FBbt:00058111 ! somatic muscle
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00059031
name: asynchronous muscle
def: "Skeletal muscle that does not exhibit a direct relationship between motor neuron activity and muscle contraction. Asynchronous muscles have very large fibrils, with nuclei scattered between them and distributed throughout the entire cross-section of the fiber. Some indirect flight muscles are asynchronous." [FlyBase:FBrf0239227]
subset: cur
synonym: "fibrillar muscle" EXACT [FlyBase:FBrf0239227]
is_a: FBbt:00058111 ! somatic muscle
