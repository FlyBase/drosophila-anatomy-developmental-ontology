property_value: http://purl.org/dc/terms/date "2022-01-18T11:52:58Z" xsd:dateTime

[Term]
id: FBbt:00052059
name: female accessory gland fat mass
def: "Adipose tissue surrounding the female accessory gland (McQueen et al., 2022). This tissue may be attached to the fat body surrounding the spermatheca (McQueen et al., 2022). It is in close contact with the rectum (Bodenstein, 1950; McQueen et al., 2022)." [FlyBase:FBrf0007733, FlyBase:FBrf0253444]
synonym: "female accessory gland fat body" EXACT [FlyBase:FBrf0253444]
