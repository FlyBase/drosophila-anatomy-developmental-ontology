[Term]
id: FBbt:00002180
name: obsolete larval abdominal transverse nerve
def: "Abdominal transverse nerve that exits the ventral nerve cord at a dorsomedial position, splits into a left and right branch and extends ventrally along the segment boundary (Gorczyca et al., 1994). Formed by the axons of the abdominal intersegmental bidendritic neuron (isbp) and the abdominal intersegmental trachea-associated neuron (istd) (Campos-Ortega, J.A., Hartenstein, V., 1997)." [FlyBase:FBrf0075005, FlyBase:FBrf0089570]
comment: Obsoleted as all transverse nerves are abdominal - making this redundant with FBbt:00001996 'larval transverse nerve'.
synonym: "larval abdominal TN" EXACT [FlyBase:FBrf0075005]
synonym: "segment boundary nerve" EXACT [FlyBase:FBrf0047289]
is_obsolete: true
replaced_by: FBbt:00001996

[Term]
id: FBbt:00002181
name: abdominal intersegmental bidendritic neuron isbp
alt_id: FBbt:00007425
def: "Bipolar dendrite neuron found in the lateral sensory cluster of a larval abdominal segment near the anterior segment boundary (Campos-Ortega and Hartenstein, 1997). It emits two long branches along the segment border muscle (muscle 8) (Williams and Shepherd, 1999). In abdominal segments 2-7, it fasciculates with the transverse nerve and forms thick neurite endings at the base of the alary muscle (Gorczyca et al., 1994; Hessinger et al., 2017)." [FlyBase:FBrf0075005, FlyBase:FBrf0089570, FlyBase:FBrf0108300, FlyBase:FBrf0234341, FlyPNS:PNSdescription.html#lbd]
subset: cur
synonym: "abdominal intersegmental bidendritic neuron isbd" EXACT [FlyBase:FBrf0089570]
synonym: "abdominal lateral bipolar dendrite neuron lbd" EXACT []
synonym: "intersegmental bipolar neuron" EXACT []
synonym: "isbp" EXACT [FlyBase:FBrf0089570]
synonym: "larval lbp neuron" EXACT [FlyBase:FBrf0089570]
synonym: "lateral bipolar md neuron" EXACT [FlyPNS:PNSdescription.html#lbd]
synonym: "LBD" EXACT [FlyBase:FBrf0075005]
