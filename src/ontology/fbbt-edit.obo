property_value: IAO:0000700 FBbt:10000000

[Term]
id: FBbt:00000000
name: germ layer derivative
def: "." [FlyBase:FBrf0043441, FlyBase:FBrf0053832]
subset: cur
subset: EmbDevSlim
intersection_of: FBbt:10000000 ! anatomical entity
intersection_of: RO:0002202 FBbt:00000110 ! develops from germ layer

[Term]
id: FBbt:00000001
name: organism
def: "An individual member of the species Drosophila melanogaster." [https://orcid.org/0000-0002-7073-9172]
subset: cur
subset: EmbDevSlim
synonym: "Drosophila" RELATED []
synonym: "whole organism" RELATED []
xref: NCBITaxon:7227
is_a: FBbt:00100313 ! multicellular structure
disjoint_from: FBbt:00004856 ! organ system
disjoint_from: FBbt:00007003 ! portion of tissue
disjoint_from: FBbt:00007009 ! organism subdivision
disjoint_from: FBbt:00007010 ! multi-tissue structure
disjoint_from: FBbt:00007229 ! cell cluster organ
disjoint_from: FBbt:00007230 ! compound cell cluster organ
disjoint_from: FBbt:00007330 ! organ system subdivision

[Term]
id: FBbt:00000002
name: tagma
def: "One of the three main divisions of the whole organism formed from groups of segments." [FBC:GG]
subset: cur
subset: FB_gloss
subset: larval_OF
is_a: FBbt:00057001 ! anterior-posterior subdivision of organism
relationship: BFO:0000050 FBbt:00000001 ! part of organism

[Term]
id: FBbt:00000003
name: segment
def: "One of the repeated divisions of the whole organism." [FBC:GG]
subset: cur
subset: FB_gloss
subset: larval_OF
is_a: FBbt:00057001 ! anterior-posterior subdivision of organism

[Term]
id: FBbt:00000004
name: head
def: "Anterior part of the organism, including mouthparts, some sensory structures and the brain." [https://orcid.org/0000-0002-1373-1705]
subset: cur
subset: larval_OF
is_a: FBbt:00000002 ! tagma

[Term]
id: FBbt:00000005
name: ocular segment
def: "Head segment derived from the second embryonic segment (between the labral and antennal segments). In the larva, this segment includes Bolwig's organ." [FlyBase:FBrf0055841, FlyBase:FBrf0075072]
comment: While classically this structure is not considered to be a segment, but rather to be the non-segmental acron - anterior to the first segment, this ontology follows Schmidt-Ott and colleagues (Schmidt-Ott et al., 1994, and Schmidt-Ott and Technau, 1992) in considering it to be the second segment (posterior to the labral segment in the segmenting embryo). This is based on relating gene expression in the early segmenting embryo to the effects of loss of function mutations of these genes on formation of larval head structures.
subset: cur
synonym: "acron" RELATED []
is_a: FBbt:00000007 ! procephalic segment

[Term]
id: FBbt:00000006
name: head segment
def: "." [FlyBase:FBrf0075072]
subset: cur
subset: larval_OF
intersection_of: FBbt:00000003 ! segment
intersection_of: BFO:0000050 FBbt:00000004 ! part of head

[Term]
id: FBbt:00000007
name: procephalic segment
def: "A segment that is anterior to the gnathal segments." [FBC:GG]
subset: cur
subset: FB_gloss
subset: larval_OF
synonym: "cephalic segment" RELATED []
synonym: "pregnathal segment" EXACT []
synonym: "preoral segment" EXACT []
synonym: "procephalon" RELATED []
is_a: FBbt:00000003 ! segment
relationship: BFO:0000050 FBbt:00000004 ! part of head

[Term]
id: FBbt:00000008
name: labral segment
def: "Anteriormost procephalic segment, anterior to the ocular segment. In the adult it bears the clypeo-labrum." [FlyBase:FBrf0055841, FlyBase:FBrf0075072, FlyBase:FBrf0089570]
subset: cur
synonym: "clypeo-labrum" RELATED []
is_a: FBbt:00000007 ! procephalic segment

[Term]
id: FBbt:00000009
name: antennal segment
def: "Segment anterior to the intercalary segment. In the adult it bears the antennae." [https://orcid.org/0000-0002-7073-9172]
subset: cur
is_a: FBbt:00000007 ! procephalic segment

[Term]
id: FBbt:00000010
name: intercalary segment
def: "Most posterior of the procephalic segments. Contains the tritocerebrum." [FlyBase:FBrf0075072, FlyBase:FBrf0089570]
subset: cur
subset: FB_gloss
is_a: FBbt:00000007 ! procephalic segment

[Term]
id: FBbt:00000011
name: gnathal segment
def: "The head segments that develop posterior to the embryonic/larval mouth." [FBC:GG]
subset: cur
subset: FB_gloss
synonym: "postoral segment" RELATED []
is_a: FBbt:00000003 ! segment
relationship: BFO:0000050 FBbt:00000004 ! part of head

[Term]
id: FBbt:00000012
name: mandibular segment
def: "Most anterior of the gnathal segments." [FlyBase:FBrf0089570]
subset: cur
is_a: FBbt:00000011 ! gnathal segment

[Term]
id: FBbt:00000013
name: maxillary segment
def: "Second gnathal segment, between the mandibular and labial segments. In the adult, it has a paired apodeme and a paired appendage, the maxillary palpus." [FlyBase:FBrf0007734, FlyBase:FBrf0089570]
subset: cur
is_a: FBbt:00000011 ! gnathal segment

[Term]
id: FBbt:00000014
name: labial segment
def: "Most posterior of the gnathal segments. In the adult it bears a pair of fused appendages, the labia, and its ectodermal invaginations give rise to the salivary glands." [FlyBase:FBrf0007734]
subset: cur
is_a: FBbt:00000011 ! gnathal segment

[Term]
id: FBbt:00000015
name: thorax
def: "The main middle section of the insect body comprising three thoracic rings: the pro-, the meso- and the metathoraces which are more or less well fused and cask-like sometimes having on the upper lateral part one of two pairs of wings, while on the ventrolateral part each thoracic ring bears a pair of legs." [FlyBase:FBrf0166419]
subset: cur
subset: FB_gloss
is_a: FBbt:00000002 ! tagma

[Term]
id: FBbt:00000016
name: thoracic segment
def: "." [FBC:Autogenerated]
subset: cur
intersection_of: FBbt:00000003 ! segment
intersection_of: BFO:0000050 FBbt:00000015 ! part of thorax

[Term]
id: FBbt:00000017
name: prothoracic segment
def: "The first (most anterior) segment of the thorax." [https://orcid.org/0000-0002-7073-9172]
subset: cur
synonym: "prothorax" RELATED []
synonym: "t1" RELATED []
synonym: "thoracic segment 1" RELATED []
is_a: FBbt:00000003 ! segment
relationship: BFO:0000050 FBbt:00000015 ! part of thorax

[Term]
id: FBbt:00000018
name: mesothoracic segment
def: "The second (middle) segment of the thorax." [https://orcid.org/0000-0002-7073-9172]
subset: cur
subset: FB_gloss
synonym: "mesothorax" RELATED []
synonym: "t2" RELATED []
synonym: "thoracic segment 2" RELATED []
is_a: FBbt:00000003 ! segment
relationship: BFO:0000050 FBbt:00000015 ! part of thorax

[Term]
id: FBbt:00000019
name: metathoracic segment
def: "The third (most posterior) segment of the thorax." [https://orcid.org/0000-0002-7073-9172]
subset: cur
subset: FB_gloss
synonym: "metathorax" RELATED []
synonym: "t3" RELATED []
synonym: "thoracic segment 3" RELATED []
is_a: FBbt:00000003 ! segment
relationship: BFO:0000050 FBbt:00000015 ! part of thorax

[Term]
id: FBbt:00000020
name: abdomen
def: "The most posterior of the three tagma (FBbt:00000002)." [FlyBase:FBrf0166419]
subset: cur
subset: FB_gloss
is_a: FBbt:00000002 ! tagma

[Term]
id: FBbt:00000021
name: abdominal segment
def: "Metameric subdivision of the abdomen." [FBC:SPR]
subset: cur
intersection_of: FBbt:00000003 ! segment
intersection_of: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000022
name: abdominal segment 1
def: "Most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a1" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000023
name: abdominal segment 2
def: "Second most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a2" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000024
name: abdominal segment 3
def: "Third most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a3" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000025
name: abdominal segment 4
def: "Fourth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a4" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000026
name: abdominal segment 5
def: "Fifth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a5" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000027
name: abdominal segment 6
def: "Sixth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a6" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000028
name: abdominal segment 7
def: "Seventh most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a7" RELATED []
is_a: FBbt:00052393 ! anterior abdominal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen

[Term]
id: FBbt:00000029
name: abdominal segment 8
def: "Eighth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a8" RELATED []
is_a: FBbt:00052388 ! terminal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen
relationship: RO:0002131 FBbt:00000033 ! overlaps telson

[Term]
id: FBbt:00000030
name: abdominal segment 9
def: "Ninth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
synonym: "a9" RELATED []
is_a: FBbt:00052388 ! terminal segment
relationship: BFO:0000050 FBbt:00000020 ! part of abdomen
relationship: BFO:0000050 FBbt:00000033 ! part of telson

[Term]
id: FBbt:00000031
name: abdominal segment 10
def: "Tenth most anterior segment of the abdomen." [https://orcid.org/0000-0002-1373-1705]
subset: cur
