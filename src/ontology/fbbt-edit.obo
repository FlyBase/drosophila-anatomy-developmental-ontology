[Term]
id: FBbt:00052785
name: haustellum bristle
def: "Bristle found on the posterior haustellum. There are usually five of these on each side (Eichler et al., 2024)." [FlyBase:FBrf0259346]
synonym: "Hau bristle" EXACT [FlyBase:FBrf0259346]
is_a: FBbt:00005177 ! chaeta
