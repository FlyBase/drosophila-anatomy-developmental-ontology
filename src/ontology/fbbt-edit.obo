property_value: http://purl.org/dc/terms/date "2022-10-27T10:57:14Z" xsd:dateTime

[Term]
id: FBbt:00052373
name: larval VNC ensheathing/wrapping glial cell
def: "Ensheathing glial cell of the larval ventral nerve cord that wraps the proximal parts of the nerve roots in addition to forming part of the sheath around the synaptic neuropil (Pogodalla et al., 2021). There are approximately two of these per hemineuromere (Pogodalla et al., 2021)." [FlyBase:FBrf0251788]
synonym: "embryonic/larval ventral nerve cord ensheathing/wrapping neuropil associated glial cell" EXACT []
