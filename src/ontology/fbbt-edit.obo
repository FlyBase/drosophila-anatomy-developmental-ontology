property_value: http://purl.org/dc/terms/date "2019-02-11T14:03:14Z" xsd:dateTime

[Term]
id: FBbt:00048140
name: adult olfactory receptor neuron Amt/Rh50
def: "Adult olfactory receptor neuron (ORN) that expresses the ammonium transporter Amt, which allows it to respond to ammonia (Vulpe et al., 2021; Task et al., 2022). It also expresses Ir25a and an additional ammonium transporter, Rh50, neither of which are necessary for sensitivity to ammonia (Vulpe et al., 2021). These neurons have their sensory dendrites in the antenna, either in ac1 sensilla or chamber III of the sacculus (Vulpe et al., 2021; Task et al., 2022). Its axon projects to antennal lobe glomerulus VM6 and arborizes in a subcompartment (Vulpe et al., 2021; Task et al., 2022). These are around 40 of these cells on each side and they all arborize bilaterally in the antennal lobes (Benton et al., 2025)." [FlyBase:FBrf0192533, FlyBase:FBrf0233453, FlyBase:FBrf0249830, FlyBase:FBrf0253272, FlyBase:FBrf0262710]
synonym: "adult olfactory receptor neuron VM6" EXACT []
synonym: "adult ORN VM6" EXACT []
synonym: "adult sensory neuron VM6" EXACT []
synonym: "odorant receptor neuron VM6" RELATED []
synonym: "Rh50+ neuron" EXACT [FlyBase:FBrf0253272]
