relationship: BFO:0000050 FBbt:00003018 ! part of adult thorax

[Term]
id: FBbt:00003091
name: adult haltere tracheal branch
def: "Tracheal branch in the adult thorax that tracheates the haltere." [FlyBase:FBrf0034081]
subset: cur
is_a: FBbt:00052127 ! tracheal branch
relationship: BFO:0000050 FBbt:00003018 ! part of adult thorax

[Term]
id: FBbt:00003092
name: adult leg tracheal branch
def: "Tracheal branch that tracheates the adult leg and arises from the thoracic air sacs. There are three distinct leg trachea per side, each extending into one of the legs." [FlyBase:FBrf0034081]
subset: cur
synonym: "adult leg trachea" EXACT []
is_a: FBbt:00052127 ! tracheal branch
relationship: BFO:0000050 FBbt:00003018 ! part of adult thorax

[Term]
id: FBbt:00003093
name: prothoracic leg tracheal branch
def: "Tracheal branch that extends into the adult prothoracic leg. It arises from the propleural air sac." [FlyBase:FBrf0034081]
