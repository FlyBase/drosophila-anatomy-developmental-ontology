property_value: http://purl.org/dc/terms/date "2024-02-06T14:17:52Z" xsd:dateTime

[Term]
id: FBbt:00052787
name: adult occipital nerve
def: "Nerve that carries projections from mechanosensory neurons of bristles on the dorsal posterior head to the lateral subesophageal zone (Eichler et al., 2024)." [FlyBase:FBrf0259346]
synonym: "OcciNv" EXACT [FlyBase:FBrf0259346]
is_a: FBbt:00005105 ! nerve
