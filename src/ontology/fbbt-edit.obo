property_value: http://purl.org/dc/terms/date "2021-05-25T12:00:20Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1147" xsd:anyURI

[Term]
id: FBbt:00058138
name: ventral peripodial epithelium of eye disc
def: "The peripodial epithelium in the ventral compartment of the eye disc. It is separated from the dorsal peripodial epithelium by the Bolwig nerve (McClure and Schubiger, 2005)." [FlyBase:FBrf0190309]
subset: cur
intersection_of: FBbt:00049582 ! peripodial epithelium of eye disc
intersection_of: BFO:0000050 FBbt:00111559 ! part of eye disc ventral compartment
