property_value: http://purl.org/dc/terms/date "2011-12-13T11:05:21Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/2181" xsd:anyURI
