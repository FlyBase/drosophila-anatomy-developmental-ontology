[Term]
id: FBbt:00004506
name: lateral ocellus
def: "Lateral ocellus located on the ocellar triangle of the dorsal postfrons of the adult head, medial to the interocellar bristles. There are two of these, each one with around 100 photoreceptors (Dorkenwald et al., 2024)." [FlyBase:FBrf0007734, FlyBase:FBrf0031004, FlyBase:FBrf0050358, FlyBase:FBrf0260546]
subset: cur
synonym: "pOC" EXACT [FlyBase:FBrf0229329]
synonym: "posterior ocellus" EXACT [FlyBase:FBrf0229329]
is_a: FBbt:00004505 ! ocellus

[Term]
id: FBbt:00004507
name: medial ocellus
def: "Medial ocellus located on the ocellar triangle of the dorsal postfrons of the adult head, just anterior to, and in between the two medial ocelli. It has around 75 photoreceptors (Dorkenwald et al., 2024). Each half is formed by one of the two (left and right) eye discs (Jean-Guillaume and Kumar, 2022)." [FlyBase:FBrf0007734, FlyBase:FBrf0031004, FlyBase:FBrf0050358, FlyBase:FBrf0255165, FlyBase:FBrf0260546]
subset: cur
synonym: "anterior ocellus" EXACT [FlyBase:FBrf0229329]
synonym: "aOC" EXACT [FlyBase:FBrf0229329]
is_a: FBbt:00004505 ! ocellus

