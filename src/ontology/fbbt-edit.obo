property_value: http://purl.org/dc/terms/date "2024-01-03T14:28:19Z" xsd:dateTime

[Term]
id: FBbt:00052767
name: flight control muscle
def: "Flight muscle involved in fine control of flight movement (Dickinson and Tu, 1997). There are 18 of these muscles on each side, including all direct flight muscles and a small number of indirect flight muscles (Dickinson and Tu, 1997). They contract synchronously with motor neuron impulses (Dickinson and Tu, 1997)." [FlyBase:FBrf0098527]
synonym: "synchronous flight muscle" EXACT [FlyBase:FBrf0098527]
