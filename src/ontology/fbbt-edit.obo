property_value: http://purl.org/dc/terms/date "2024-05-10T18:28:51Z" xsd:dateTime

[Term]
id: FBbt:00053176
name: adult cervical nerve neck motor neuron
def: "Adult neck muscle motor neuron that enters the cervical connective, then exits via the cervical nerve to reach its muscle target (Gorko et al., 2024). Most of these cells have somas in the brain, but there are also some in the ventral nerve cord (Gorko et al., 2024)." [FlyBase:FBrf0259326]
synonym: "adult CvN motor neuron" EXACT [FlyBase:FBrf0259326]
intersection_of: FBbt:00053172 ! neck muscle motor neuron
