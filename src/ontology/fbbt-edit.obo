property_value: http://purl.org/dc/terms/date "2010-03-16T01:35:29Z" xsd:dateTime

[Term]
id: FBbt:00100115
name: twin sensillum of margin 2 neuron
def: "Neuron innervating the twin sensillum of margin 2. This neuron begins axonogenesis at approximately 9-10 hours AP (Murray et al., 1984). It innervates the more proximal of the pair of twin sensilla (Dickinson and Palka, 1987)." [FlyBase:FBrf0040724, FlyBase:FBrf0046837]
synonym: "p-TSM neuron" EXACT [FlyBase:FBrf0046837]
