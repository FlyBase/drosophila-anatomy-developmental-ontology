property_value: http://purl.org/dc/terms/date "2022-08-23T15:47:18Z" xsd:dateTime

[Term]
id: FBbt:00052300
name: adult male pheromone-sensing neuron of leg
def: "Adult gustatory neuron of the leg that detects male pheromones (Thistle et al., 2012; Kallman et al., 2015). It can be distinguished from female pheromone-detecting cells based on its lack of expression of ppk25 (Kallman et al., 2015). Some of these cells project to the subesophageal zone (Kallman et al., 2015)." [FlyBase:FBrf0218411, FlyBase:FBrf0230436]
comment: Not glutamatergic (Kallman et al., 2015).
subset: cur
synonym: "leg PPK23+ PPK25- neuron" EXACT [FlyBase:FBrf0230436]
synonym: "M cell of leg" EXACT [FlyBase:FBrf0230436]
