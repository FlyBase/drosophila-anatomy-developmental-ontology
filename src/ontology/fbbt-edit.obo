synonym: "leg branch 1" EXACT []
is_a: FBbt:00003092 ! adult leg tracheal branch
relationship: RO:0002150 FBbt:00003113 ! continuous with propleural air sac

[Term]
id: FBbt:00003094
name: mesothoracic leg tracheal branch
def: "Tracheal branch that extends into the adult mesothoracic leg. It arises from the sternopleural air sac." [FlyBase:FBrf0034081]
subset: cur
synonym: "leg branch 2" EXACT []
is_a: FBbt:00003092 ! adult leg tracheal branch
relationship: RO:0002150 FBbt:00003117 ! continuous with sternopleural air sac

[Term]
id: FBbt:00003095
name: metathoracic leg tracheal branch
def: "Tracheal branch that extends into the adult metathoracic leg. It arises from the hypopleural air sac." [FlyBase:FBrf0034081]
