[Term]
id: FBbt:00059243
name: adult claw neuron
def: "Adult cholinergic neuron of the central brain that sends four claw-like projections to the posterior brain (Sun et al., 2022). It receives input from DN clock neurons and has presynapses in the gamma lobe of the mushroom body (Sun et al., 2022). Its activity enhances sleep depth (Sun et al., 2022). There are around 20 of these neurons per hemisphere (Sun et al., 2022)." [FlyBase:FBrf0253946]
subset: cur
synonym: "CL neuron" EXACT [FlyBase:FBrf0253946]
is_a: FBbt:00005106 ! neuron
relationship: RO:0002215 GO:0014055 ! capable of acetylcholine secretion, neurotransmission
relationship: RO:0002216 GO:0030431 ! capable of part of sleep
relationship: RO:0013003 FBbt:00013695 ! sends synaptic output to region adult mushroom body gamma-lobe
relationship: RO:0013008 FBbt:00003628 ! receives synaptic input from neuron adult DN period neuron
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2023-06-01T14:53:51Z" xsd:dateTime

