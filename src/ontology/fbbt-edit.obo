[Term]
id: FBbt:00052062
name: hypogynial anteroventral bridge
def: "A transverse, strongly sclerotized rod connecting the anterior tips of the hypogynial valves beneath the oviprovector and the vagina." [FlyBase:FBrf0253444]
synonym: "basal isthmus" EXACT [FlyBase:FBrf0253444]
synonym: "heavily sclerotized bar" EXACT [FlyBase:FBrf0253444]
