property_value: http://purl.org/dc/terms/date "2022-01-18T13:32:34Z" xsd:dateTime

[Term]
id: FBbt:00052060
name: genital chamber furca
def: "The dorsal wall of the genital chamber that developmentally arises from the segment 9 (male genital) primordium in the female genital disc (McQueen et al., 2022). It extends from the female accessory gland ducts anteriorly to the vulva posteriorly (McQueen et al., 2022). It is divided into a uterine furca, in which the female accessory gland ducts open and has an inner posterior thickness called the papillate elevation, and a vaginal furca, which extrudes from the vulva during oviposition (McQueen et al., 2022)." [FlyBase:FBrf0253444]
synonym: "female sternite 9" EXACT [FlyBase:FBrf0253444]
synonym: "genital fork" EXACT [FlyBase:FBrf0253444]
synonym: "vaginal apodeme" EXACT [FlyBase:FBrf0253444]
