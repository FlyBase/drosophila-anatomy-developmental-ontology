property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00058812
name: transverse vertex muscle
def: "Temporary muscle that lies underneath the adult dorsal head (vertex) and extends transversely between the compound eyes. The contraction of this muscle layer diminishes the volume of the head. As with other temporary eclosion muscles, it soon degenerates and is not found in older flies." [FlyBase:FBrf0007310, FlyBase:FBrf0186027]
subset: cur
is_a: FBbt:00058806 ! adult ptilinal muscle
is_a: FBbt:00059067 ! temporary eclosion muscle
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00058813
name: ptilino-tentorial muscle
def: "Temporary muscle that is inserted on the ptilinum at each side dorso-laterally as a narrow band, immediately in front of the line of demarcation between the vertex and the ptilinum. As with other temporary eclosion muscles, it degenerates 20h after adult emergence." [FlyBase:FBrf0007310]
subset: cur
is_a: FBbt:00058806 ! adult ptilinal muscle
is_a: FBbt:00059067 ! temporary eclosion muscle
relationship: RO:0002371 FBbt:00004483 ! attached to ptilinum
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00058814
name: lunula muscle
def: "Unpaired, long and thin muscle that arises from the dorsal rim of the occipital foramen and connects to the lunule of the fronto-clypeus (Atkins, 1949). It retracts the ptilinum and the fronto-clypeus after adult emergence (Atkins, 1949). Unlike other ptilinal muscles, it does not seem to degenerate after eclosion (Atkins, 1949)." [FlyBase:FBrf0007310]
subset: cur
synonym: "lunular muscle" EXACT [FlyBase:FBrf0007310]
is_a: FBbt:00058806 ! adult ptilinal muscle
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00058815
name: ocular-antennal muscle
def: "Muscle inserted on the adult ocular sclerites at the dorso-cephalic margin of the compound eyes, connecting to the second antennal segment. It functions to deflate the head during emergence by approximating the vertex and the fronto-clypeus and to retract the antenna. By 72h after emergence, the muscles have completely disintegrated." [FlyBase:FBrf0007310]
subset: cur
synonym: "oculo-antennal muscle" EXACT [FlyBase:FBrf0007310]
