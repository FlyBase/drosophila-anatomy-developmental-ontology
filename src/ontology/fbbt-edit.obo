synonym: "MBON-11" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-gamma1pedc>alpha/beta" EXACT [FlyBase:FBrf0227179]
synonym: "mushroom body pedunculus-medial lobe and vertical lobe arborizing neuron 2" EXACT []
