property_value: http://purl.org/dc/terms/date "2020-11-23T08:47:12Z" xsd:dateTime

[Term]
id: FBbt:00049921
name: oviposition descending neuron oviDNb
def: "Oviposition descending neuron with bilateral arborization in the abdominal neuromere, which is relatively anterolateral to that of other oviDN cell types (Wang et al., 2020; Sturner et al., 2025). In the brain, it bifurcates near the midline forming a dorsal projection that arborizes in the superior medial protocerebrum, as well as a ventral descending branch (Wang et al., 2020; Sturner et al., 2025). There is one of these cells per hemisphere (Sturner et al., 2025). It expresses fruitless, but not doublesex (Wang et al., 2020)." [FlyBase:FBrf0245074, FlyBase:FBrf0262850]
is_a: FBbt:00049919 ! oviposition descending neuron oviDN
relationship: RO:0002292 http://flybase.org/reports/FBgn0004652 ! expresses fru
