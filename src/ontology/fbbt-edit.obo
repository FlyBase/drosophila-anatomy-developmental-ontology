synonym: "larval GNG" EXACT []
synonym: "larval SEG" EXACT [FlyBase:FBrf0237252]
synonym: "larval SOG" EXACT []
synonym: "larval subesophageal zone" BROAD [FlyBase:FBrf0238045]
synonym: "larval suboesophageal ganglion" RELATED []
