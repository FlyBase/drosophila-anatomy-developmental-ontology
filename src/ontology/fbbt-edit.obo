property_value: http://purl.org/dc/terms/date "2013-05-23T03:45:07Z" xsd:dateTime
property_value: IAO:0000233 "https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/106" xsd:anyURI

