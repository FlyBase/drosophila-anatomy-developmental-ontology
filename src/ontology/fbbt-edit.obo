[Term]
id: FBbt:00059065
name: occlusor muscle of adult abdominal spiracle
def: "A short muscle that functions in closing an adult abdominal spiracle. These muscles are attached to sclerotised lever which is in turn attached to a deep fold in the wall of spiracle at the base of the spiracular chamber. The other end is attached to a rigid part of the wall of the spiracular chamber so that its contraction closes the passage. There is no dilator muscle so the passage is probably kept open by its natural elasticity (Miller, 1950 pg 459)." [FlyBase:FBrf0007735]
subset: cur
intersection_of: FBbt:00059064 ! spiracular occlusor muscle
intersection_of: RO:0002371 FBbt:00004814 ! attached to adult abdominal spiracle
relationship: BFO:0000050 FBbt:00003024 ! part of adult abdominal segment
relationship: RO:0002371 FBbt:00003122 ! attached to lever of abdominal spiracle
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

[Term]
id: FBbt:00059066
name: occlusor muscle of adult thoracic spiracle
def: "A muscle that functions in closing an adult thoracic spiracle. These muscles attach the rim (peritreme) of spiracle and to the adjacent body wall. Their contraction serves to bring the two lips of the spiracle together." [FlyBase:FBrf0007735]
subset: cur
intersection_of: FBbt:00059064 ! spiracular occlusor muscle
intersection_of: RO:0002371 FBbt:00014814 ! attached to adult thoracic spiracle
relationship: BFO:0000050 FBbt:00003019 ! part of adult thoracic segment
property_value: http://purl.org/dc/terms/contributor https://orcid.org/0000-0002-6095-8718
property_value: http://purl.org/dc/terms/date "2022-07-05T13:30:44Z" xsd:dateTime

